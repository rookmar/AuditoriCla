<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sistema de Auditorias</title>

  <!-- Tu lógica de login; no se toca -->
  <script src="/js/login.js?v=1" defer></script>

  <style>
    :root{
      --brand:#c7352b;        /* rojo barra */
      --brand-dark:#a72b23;
      --bg:#f5f6fa;
      --card:#fff;
      --txt:#222;
      --muted:#667085;
      --ring:#e6e7eb;
      --shadow:0 12px 28px rgba(16, 24, 40, .08);
      --radius:16px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Inter, "Helvetica Neue", Arial, "Noto Sans";
      color:var(--txt);
      background:var(--bg);
    }

    /* Barra superior */
    .topbar{
      background:var(--brand);
      color:#fff;
      padding:18px 22px;
      position:sticky; top:0; z-index:10;
      box-shadow:0 2px 0 rgba(0,0,0,.03);
    }
    .topbar .wrap{
      max-width:1160px; margin:0 auto; display:flex; align-items:center; gap:16px;
    }
    .title{
      font-size:22px; font-weight:800; letter-spacing:.2px;
    }

    /* Contenido centrado */
    .container{ max-width:1160px; margin:28px auto; padding:0 20px; }

    .login-card{
      width: 640px;
      max-width: 100%;
      margin: 64px auto 40px;
      background:var(--card);
      border:1px solid var(--ring);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding: 28px;
    }
    h1{
      margin: 6px 0 18px;
      font-size: 34px;
      font-weight: 800;
      letter-spacing: .2px;
    }

    .field{ margin:14px 0 }
    .field label{
      display:block; font-size:14px; color:var(--muted); margin-bottom:8px;
    }
    .input{
      width:100%; height:48px;
      border:1px solid var(--ring); border-radius:12px;
      padding:0 14px; font-size:16px;
      background:#fff; outline:none; transition:border-color .15s ease, box-shadow .15s ease;
    }
    .input:focus{
      border-color:var(--brand);
      box-shadow:0 0 0 3px rgba(199,53,43,.15);
    }

    /* --- Ojo dentro del input (solo visual) --- */
    .input-wrap{ position:relative }
    .input-wrap .input{ padding-right:44px } /* espacio para el botón */
    .eye-btn{
      position:absolute; right:10px; top:50%; transform:translateY(-50%);
      border:none; background:transparent; cursor:pointer; padding:6px;
      display:grid; place-items:center; border-radius:8px;
    }
    .eye-btn:focus-visible{ outline:2px solid var(--brand) }

    .actions{ margin-top:10px; display:flex; gap:12px }
    .btn{
      appearance:none; border:0; outline:0; cursor:pointer;
      height:42px; padding:0 18px; border-radius:12px;
      font-weight:700; font-size:15px;
      background:#e7eaee; color:#222;
    }
    .btn.primary{
      background:var(--brand); color:#fff;
      box-shadow: 0 6px 14px rgba(199,53,43,.25);
    }
    .btn.primary:hover{ background:var(--brand-dark) }

    /* Mensaje */
    #msg{
      margin-top:14px; font-size:14px; color:#b42318; font-weight:700;
      min-height:18px;
    }

    /* Badge inferior */
    .brand-badge{
      position:fixed; left:16px; bottom:16px;
      background:#fff; color:#374151;
      border:1px solid var(--ring); border-radius:999px;
      box-shadow:var(--shadow);
      display:flex; align-items:center; gap:10px;
      padding:10px 14px;
      font-size:13px;
    }
    .brand-badge .logo{
      width:22px; height:22px; display:grid; place-items:center;
      border-radius:999px; background:#fef2f2; color:#c7352b; font-weight:800;
      border:1px solid #fde4e4;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Inter, "Helvetica Neue", Arial;
    }

    /* Pequeños ajustes responsivos */
    @media (max-width: 520px){
      .login-card{ margin-top:32px; padding:22px }
      h1{ font-size:28px }
    }
  </style>
</head>
<body>

  <!-- Barra roja superior (sin botones extra) -->
  <header class="topbar">
    <div class="wrap">
      <div class="title">Sistema de Auditoria</div>
    </div>
  </header>

  <main class="container">
    <section class="login-card">
      <h1>Iniciar sesión</h1>

      <div class="field">
        <label for="usuario">Usuario</label>
        <input id="usuario" class="input" type="text" autocomplete="username" />
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <div class="input-wrap">
          <input id="password" class="input" type="password" autocomplete="current-password" />
          <button id="togglePassword" class="eye-btn" type="button" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
            <!-- Ícono ojo -->
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="actions">
        <button id="btnLogin" class="btn primary" type="button">Entrar</button>
      </div>

      <!-- Aquí tu login.js escribe los mensajes (INVALID_CREDENTIALS, etc.) -->
      <div id="msg"></div>
    </section>
  </main>

  <!-- Badge inferior izquierdo -->
  <div class="brand-badge">
    <div class="logo">C</div>
    <span>Sistema de auditoría Claro 2025</span>
  </div>

  <!-- Script mínimo para el toggle del ojo (no toca tu login.js) -->
  <script>
    (function () {
      const pwd = document.getElementById('password');
      const btn = document.getElementById('togglePassword');

      if (!pwd || !btn) return;

      function setIcon(visible){
        btn.setAttribute('aria-pressed', String(!!visible));
        btn.title = visible ? 'Ocultar contraseña' : 'Mostrar contraseña';
        btn.setAttribute('aria-label', btn.title);
        btn.innerHTML = visible
          ? `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
               <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.17-5.95M9.88 9.88A3 3 0 0 0 12 15a3 3 0 0 0 2.12-5.12"/>
               <line x1="1" y1="1" x2="23" y2="23"/>
             </svg>`
          : `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
               <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
               <circle cx="12" cy="12" r="3"/>
             </svg>`;
      }

      btn.addEventListener('click', () => {
        const show = pwd.type === 'password';
        pwd.type = show ? 'text' : 'password';
        setIcon(show);
        pwd.focus({ preventScroll: true });
      });

      setIcon(false);
    })();
  </script>
</body>
</html>
