<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ruta</title>

  <script src="/js/ruta.js?v=9.21" defer></script>

  <style>
    :root{--brand:#c7352b;--brand-dark:#a72b23;--bg:#f5f6fa;--card:#fff;--txt:#222;--muted:#667085;--ring:#e6e7eb;--shadow:0 12px 28px rgba(16,24,40,.08);--radius:16px}
    *{box-sizing:border-box} html,body{height:100%}
    body{margin:0;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Inter,"Helvetica Neue",Arial;color:var(--txt);background:var(--bg)}
    .topbar{background:var(--brand);color:#fff;padding:18px 22px;position:sticky;top:0;z-index:10}
    .topbar .wrap{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .title{font-size:22px;font-weight:800;letter-spacing:.2px}
    .right{display:flex;align-items:center;gap:14px}
    .welcome-pill{padding:10px 16px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(2px);font-weight:800;white-space:nowrap}
    .btn{appearance:none;border:0;outline:0;cursor:pointer;height:40px;padding:0 16px;border-radius:12px;font-weight:800;font-size:14px}
    .btn.white{background:#fff;color:var(--brand);box-shadow:0 6px 14px rgba(199,53,43,.18)}
    .btn.white:hover{background:#f7f7f7}
    .btn.primary{background:var(--brand);color:#fff;box-shadow:0 6px 14px rgba(199,53,43,.25)}
    .btn.primary:hover{background:var(--brand-dark)}
    .container{max-width:1160px;margin:28px auto;padding:0 20px}
    .card{background:var(--card);border:1px solid var(--ring);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px;margin-bottom:24px}
    h1{margin:6px 0 18px;font-size:34px;font-weight:800;letter-spacing:.2px}
    h3{margin:22px 0 10px}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .field{display:flex;flex-direction:column;gap:8px}
    .field.full{grid-column:1/-1}
    .input{width:100%;height:46px;border:1px solid var(--ring);border-radius:12px;padding:0 14px;font-size:16px;background:#fff;outline:none;transition:border-color .15s,box-shadow .15s}
    .input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(199,53,43,.15)}
    .table-wrap{width:100%;overflow:auto}
    table{width:100%;border-collapse:collapse}
    thead th{font-size:13px;color:var(--muted);text-align:left;border-bottom:1px solid var(--ring);padding:10px 12px;white-space:nowrap}
    tbody td{padding:12px;border-bottom:1px solid var(--ring);font-size:15px;vertical-align:middle;white-space:nowrap}
    .text-right{text-align:right}
    .brand-badge{position:fixed;left:16px;bottom:16px;background:#fff;color:#374151;border:1px solid var(--ring);border-radius:999px;box-shadow:var(--shadow);display:flex;align-items:center;gap:10px;padding:10px 14px;font-size:13px}
    .brand-badge .logo{width:22px;height:22px;display:grid;place-items:center;border-radius:999px;background:#fef2f2;color:var(--brand);font-weight:800;border:1px solid #fde4e4}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="wrap">
      <div class="title">Ruta</div>
      <div class="right">
        <div class="welcome-pill" id="welcomeText">Bienvenido…</div>
        <button id="btnMenu" class="btn white">Menú</button>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="card">
      <h1>Ruta</h1>

      <!-- Coordenadas -->
      <h3>Coordenadas</h3>
      <div class="grid-2">
        <div class="field full">
          <label for="coordenadas">URL/Coordenadas</label>
          <input id="coordenadas" class="input" type="text" placeholder="https://maps..., 14.62,-90.55" />
        </div>
      </div>

      <!-- Central (obligatoria) -->
      <h3>Central</h3>
      <div class="grid-2">
        <div class="field">
          <label for="nombre_central">Nombre central</label>
          <input id="nombre_central" class="input" type="text" />
        </div>
        <div class="field">
          <label for="ID_central">ID central</label>
          <input id="ID_central" class="input" type="text" />
        </div>
      </div>

      <!-- Cliente (sin Puerto cliente) -->
      <h3>Cliente</h3>
      <div class="grid-2">
        <div class="field">
          <label for="nombre_cliente">Nombre cliente</label>
          <input id="nombre_cliente" class="input" type="text" />
        </div>
        <div class="field">
          <label for="tarea">Tarea</label>
          <input id="tarea" class="input" type="text" />
        </div>
      </div>

      <!-- ODF -->
      <h3>ODF</h3>
      <div class="grid-2">
        <div class="field">
          <label for="nombre_odf">Nombre ODF</label>
          <input id="nombre_odf" class="input" type="text" />
        </div>
        <div class="field">
          <label for="nemonico_odf">Nemonico ODF</label>
          <input id="nemonico_odf" class="input" type="text" />
        </div>
        <div class="field full">
          <label for="odf_puerto">Puerto ODF</label>
          <input id="odf_puerto" class="input" type="text" />
        </div>
      </div>

      <!-- Patcheo -->
      <h3>Patcheo</h3>
      <div class="grid-2">
        <div class="field">
          <label for="nemonico_patcheo">Nemonico Patcheo</label>
          <input id="nemonico_patcheo" class="input" type="text" />
        </div>
        <div class="field">
          <label for="puerto_patcheo">Puerto (patcheo)</label>
          <input id="puerto_patcheo" class="input" type="text" />
        </div>
      </div>

      <!-- Equipo -->
      <h3>Equipo</h3>
      <div class="grid-2">
        <div class="field">
          <label for="nemonico_equipo">Nemonico Equipo</label>
          <input id="nemonico_equipo" class="input" type="text" />
        </div>
        <div class="field">
          <label for="marca">Marca</label>
          <input id="marca" class="input" type="text" />
        </div>
        <div class="field">
          <label for="slot">Slot</label>
          <input id="slot" class="input" type="text" />
        </div>
        <div class="field">
          <label for="posicion">Posición</label>
          <input id="posicion" class="input" type="text" />
        </div>
      </div>

      <div style="margin-top:16px">
        <button id="btnGuardar" class="btn primary">Guardar</button>
      </div>
    </section>

    <!-- Rutas recientes -->
    <section class="card">
      <h2 style="margin:0 0 14px">Rutas recientes</h2>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Cliente</th>
              <th>Patcheo</th>
              <th>Equipo</th>
              <th>Coordenadas</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="recientesBody">
            <tr id="recientesLoading"><td colspan="6">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <div class="brand-badge"><div class="logo">C</div><span>Sistema de auditoría Claro 2025</span></div>

  <script>
    (async () => {
      try{
        const r = await fetch('/api/me?_=' + Date.now(), {credentials:'include', cache:'no-store'});
        if(!r.ok) return;
        const data = await r.json().catch(()=>({}));
        const u = data?.user; if(!u) return;
        const nombre = (u.nombre && String(u.nombre).trim()) || u.usuario || 'Usuario';
        const rol = String(u.rol || (u.admin ? 'admin' : '') || '').toLowerCase();
        const el = document.getElementById('welcomeText');
        if(el) el.textContent = `Bienvenido, ${nombre}${rol ? ` (${rol})` : ''}`;
      }catch{}
    })();
    document.getElementById('btnMenu')?.addEventListener('click', () => location.href = '/menu.html');
  </script>
</body>
</html>
